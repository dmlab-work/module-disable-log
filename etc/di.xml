<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\Model\Logger">
        <plugin name="dmlab_disable_log_skip_customer_log"
                type="DmLab\DisableLog\Plugin\Customer\SkipCustomerLog"/>
    </type>
    <type name="Magento\Customer\Model\ResourceModel\Visitor">
        <plugin name="dmlab_disable_log_skip_visitor_log"
                type="DmLab\DisableLog\Plugin\Customer\SkipVisitorLog"/>
    </type>
    <type name="Magento\Reports\Model\ResourceModel\Product\Index\AbstractIndex">
        <plugin name="dmlab_disable_log_skip_anonymous_product_index"
                type="DmLab\DisableLog\Plugin\Reports\SkipAnonymousProductIndex"/>
    </type>
    <type name="Magento\Search\Model\Query">
        <plugin name="dmlab_disable_log_skip_search_log"
                type="DmLab\DisableLog\Plugin\Search\SkipSearchLog"/>
    </type>
    <virtualType name="SessionValidator">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="dmlab_disable_log_visitorless_cutoff_validator" xsi:type="object">
                    DmLab\DisableLog\Model\Session\VisitorlessCutoffValidator
                </item>
            </argument>
        </arguments>
    </virtualType>
</config>
