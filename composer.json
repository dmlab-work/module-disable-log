{
    "name": "dmlab/module-disable-log",
    "description": "Per-source admin toggles to disable Magento's high-frequency core logging: customer login/logout log, online-visitor tracking and search-query stats. Default off — installing changes nothing.",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "logging",
        "disable log",
        "customer log",
        "visitor log",
        "customer_visitor",
        "customer_log",
        "online customers",
        "search terms",
        "search_query",
        "performance",
        "database",
        "database growth"
    ],
    "homepage": "https://github.com/dmlab-work/module-disable-log",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.0.2",
    "support": {
        "issues": "https://github.com/dmlab-work/module-disable-log/issues",
        "source": "https://github.com/dmlab-work/module-disable-log"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-config": "^101.2.7",
        "magento/module-customer": "^103.0.7-p9",
        "magento/module-reports": "^100.4.7",
        "magento/module-search": "^101.1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\DisableLog\\": ""
        }
    }
}
